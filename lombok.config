# 컨벤션 3.5 — 금지 애노테이션을 컴파일 에러로 강제한다.
# 규칙은 문서가 아니라 도구가 지킨다.

config.stopBubbling = true

# @Data — setter/equals/toString을 한꺼번에 열어 도메인 불변성과 JPA 안전성을 동시에 깬다
lombok.data.flagUsage = ERROR

# @Setter — 상태 변경은 의미 있는 이름의 메서드로만. 상태 전이 규칙이 우회된다
lombok.setter.flagUsage = ERROR

# @AllArgsConstructor — 같은 타입 필드가 인접하면 순서 변경이 조용히 깨진다
lombok.allArgsConstructor.flagUsage = ERROR

# 생성된 코드에 @lombok.Generated 를 붙여 커버리지 측정에서 제외한다
lombok.addLombokGeneratedAnnotation = true
